{
  "name": "scientific-core-research-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/build-search-index.mjs",
    "build": "next build",
    "preview": "python -m coscientist.site preview-site --portal-root .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:content": "python -m coscientist.site validate-content --portal-root .",
    "test:links": "node scripts/check-static-links.mjs",
    "test:basepath": "node scripts/check-basepath-export.mjs",
    "test:budget": "node scripts/check-asset-budget.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:content && pnpm build && pnpm test:links && pnpm test:budget"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pdfjs-dist": "^6.1.200",
    "react-markdown": "^10.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
