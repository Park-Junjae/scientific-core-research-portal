{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-core.local/schemas/research-idea-manifest-v1.schema.json",
  "title": "ResearchIdeaManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea_id", "slug", "title", "short_title", "abstract", "category", "disposition", "recommendation", "tags", "origin", "updated_at", "language_variants", "report_pdf", "report_markdown", "knowledge_refs", "reference_count", "figure_count", "publication_status"],
  "properties": {
    "schema_version": {"const": "ResearchIdeaManifestV1"},
    "idea_id": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "short_title": {"type": "string", "minLength": 1},
    "abstract": {"type": "string", "minLength": 40},
    "category": {"type": "string"},
    "disposition": {"type": "string"},
    "recommendation": {"enum": ["Recommended for focused testing", "Refine before testing", "Background program", "Measurement-method research", "Parked", "Not retained"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "origin": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "language_variants": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1},
    "report_pdf": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1},
    "report_markdown": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1},
    "knowledge_refs": {"type": "array", "items": {"type": "string"}},
    "reference_count": {"type": "integer", "minimum": 0},
    "figure_count": {"type": "integer", "minimum": 0},
    "publication_status": {"enum": ["APPROVED", "DEMO_ONLY", "WITHHELD"]}
  }
}
