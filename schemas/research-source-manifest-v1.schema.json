{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-core.local/schemas/research-source-manifest-v1.schema.json",
  "title": "ResearchSourceManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "localized_title", "authors", "journal", "year", "volume", "pages_or_article_number", "doi", "pmid", "url", "source_type", "evidence_role", "access_level", "full_text_reviewed", "deeply_read", "load_bearing", "localized_relevance", "localized_shows", "localized_does_not_show", "related_run_ids", "related_idea_ids", "related_report_ids", "related_report_sections", "cited_in_reports", "publication_status"],
  "properties": {
    "schema_version": {"const": "ResearchSourceManifestV1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "localized_title": {"$ref": "#/$defs/localized"},
    "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "journal": {"type": "string"},
    "year": {"type": "integer", "minimum": 1800, "maximum": 2200},
    "volume": {"type": ["string", "null"]},
    "pages_or_article_number": {"type": ["string", "null"]},
    "doi": {"type": ["string", "null"]},
    "pmid": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"], "format": "uri"},
    "source_type": {"type": "string"},
    "evidence_role": {"enum": ["ANCHOR", "DIRECT_PRECEDENT", "MECHANISM", "METHODS", "CONTRADICTORY", "NEGATIVE", "SAFETY", "CONTEXT", "REVIEW"]},
    "access_level": {"enum": ["CITATION_ONLY", "ABSTRACT", "MAIN_TEXT", "MAIN_TEXT_AND_METHODS", "FULL_TEXT", "FULL_TEXT_AND_SUPPLEMENT", "SOURCE_DATA"]},
    "analysis_stage": {"enum": ["SOURCE_ATLAS_CURATED", "BIBLIOGRAPHY_SOURCE_VERIFIED", "DISCOVERED_ONLY", "SEARCH_RESULT_ONLY", "TITLE_ABSTRACT_SCREENED", "FULL_TEXT_TRIAGED", "FULL_TEXT_REVIEWED", "DEEPLY_READ", "LOAD_BEARING", "CITED", "DUPLICATE", "DUPLICATE_RECORD", "REPORT_REFERENCE_ENTRY", "REPEATED_CITATION", "UNSCREENED", "UNSCREENED_SOURCE"]},
    "corpus_membership": {"enum": ["SOURCE_ATLAS_ONLY", "SOURCE_ATLAS_AND_FINAL_REPORT", "FINAL_REPORT_ADDITION"]},
    "source_atlas_member": {"type": "boolean"},
    "final_report_cited": {"type": "boolean"},
    "first_seen_stage": {"enum": ["SOURCE_ATLAS_CURATED", "TITLE_ABSTRACT_ANALYZED", "FULL_TEXT_REVIEWED", "MECHANISM_EVIDENCE_MAPPED", "CONTRADICTORY_EVIDENCE_MAPPED", "REPORT_ARGUMENT_USED", "BIBLIOGRAPHY_SOURCE_VERIFIED"]},
    "last_used_stage": {"enum": ["SOURCE_ATLAS_CURATED", "TITLE_ABSTRACT_ANALYZED", "FULL_TEXT_REVIEWED", "MECHANISM_EVIDENCE_MAPPED", "CONTRADICTORY_EVIDENCE_MAPPED", "REPORT_ARGUMENT_USED", "BIBLIOGRAPHY_SOURCE_VERIFIED"]},
    "analysis_event_count": {"type": "integer", "minimum": 1},
    "full_text_reviewed": {"type": ["boolean", "null"]},
    "deeply_read": {"type": ["boolean", "null"]},
    "load_bearing": {"type": "boolean"},
    "localized_relevance": {"$ref": "#/$defs/localized"},
    "localized_shows": {"$ref": "#/$defs/localized"},
    "localized_does_not_show": {"$ref": "#/$defs/localized"},
    "related_run_ids": {"type": "array", "items": {"type": "string"}},
    "related_idea_ids": {"type": "array", "items": {"type": "string"}},
    "related_report_ids": {"type": "array", "items": {"type": "string"}},
    "related_report_sections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["report_id", "section_ids"], "properties": {"report_id": {"type": "string"}, "section_ids": {"type": "array", "items": {"type": "string"}}}}},
    "cited_in_reports": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["report_id", "citation_numbers"], "properties": {"report_id": {"type": "string"}, "citation_numbers": {"type": "array", "items": {"type": "integer", "minimum": 1}}}}},
    "publication_status": {"enum": ["APPROVED", "DEMO_ONLY", "WITHHELD"]},
    "display_order": {"type": "integer", "minimum": 0}
  },
  "$defs": {"localized": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"ko": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}}}
}
