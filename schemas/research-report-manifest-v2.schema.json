{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-core.local/schemas/research-report-manifest-v2.schema.json",
  "title": "ResearchReportManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "translation_group_id", "role", "localized_title", "localized_description", "language", "path", "markdown_path", "page_count", "reference_count", "primary_source_count", "report_status", "is_primary", "display_order", "updated_at"],
  "properties": {
    "schema_version": {"const": "ResearchReportManifestV2"},
    "report_id": {"type": "string", "minLength": 1},
    "translation_group_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["KNOWLEDGE_BACKGROUND", "IDEA_REPORT", "PORTFOLIO_DECISION", "RESEARCH_SUMMARY", "RUN_SPECIFICATION", "MEASUREMENT_REPORT", "TECHNICAL_APPENDIX"]},
    "localized_title": {"$ref": "#/$defs/localized"},
    "localized_description": {"$ref": "#/$defs/localized"},
    "language": {"enum": ["ko", "en"]},
    "path": {"type": ["string", "null"]},
    "markdown_path": {"type": ["string", "null"]},
    "page_count": {"type": ["integer", "null"], "minimum": 1},
    "reference_count": {"type": ["integer", "null"], "minimum": 0},
    "primary_source_count": {"type": ["integer", "null"], "minimum": 0},
    "report_status": {"enum": ["DRAFT", "APPROVED", "DEMO_SUMMARY", "WITHHELD"]},
    "is_primary": {"type": "boolean"},
    "display_order": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"localized": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"ko": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}}}
}
