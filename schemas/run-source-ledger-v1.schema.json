{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-core.local/schemas/run-source-ledger-v1.schema.json",
  "title": "RunSourceLedgerV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "deduplication_order", "source_count", "sources"],
  "properties": {
    "schema_version": {"const": "RunSourceLedgerV1"},
    "run_id": {"type": "string", "minLength": 1},
    "deduplication_order": {"const": ["DOI", "PMID", "NORMALIZED_TITLE_YEAR"]},
    "source_count": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "doi", "pmid", "normalized_title", "year", "source_atlas_member", "final_report_cited", "load_bearing", "corpus_membership", "first_seen_stage", "last_used_stage", "analysis_event_count", "analysis_events", "related_report_ids", "related_idea_ids", "access_level"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "doi": {"type": ["string", "null"]},
          "pmid": {"type": ["string", "null"]},
          "normalized_title": {"type": "string", "minLength": 1},
          "year": {"type": "integer", "minimum": 1800, "maximum": 2200},
          "source_atlas_member": {"type": "boolean"},
          "final_report_cited": {"type": "boolean"},
          "load_bearing": {"type": "boolean"},
          "corpus_membership": {"enum": ["SOURCE_ATLAS_ONLY", "SOURCE_ATLAS_AND_FINAL_REPORT", "FINAL_REPORT_ADDITION"]},
          "first_seen_stage": {"$ref": "#/$defs/eventType"},
          "last_used_stage": {"$ref": "#/$defs/eventType"},
          "analysis_event_count": {"type": "integer", "minimum": 1},
          "analysis_events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_type", "stage_id"],
              "properties": {
                "event_type": {"$ref": "#/$defs/eventType"},
                "stage_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "related_report_ids": {"type": "array", "items": {"type": "string"}},
          "related_idea_ids": {"type": "array", "items": {"type": "string"}},
          "access_level": {"enum": ["CITATION_ONLY", "ABSTRACT", "MAIN_TEXT", "MAIN_TEXT_AND_METHODS", "FULL_TEXT", "FULL_TEXT_AND_SUPPLEMENT", "SOURCE_DATA"]}
        }
      }
    }
  },
  "$defs": {
    "eventType": {"enum": ["SOURCE_ATLAS_CURATED", "TITLE_ABSTRACT_ANALYZED", "FULL_TEXT_REVIEWED", "MECHANISM_EVIDENCE_MAPPED", "CONTRADICTORY_EVIDENCE_MAPPED", "REPORT_ARGUMENT_USED", "BIBLIOGRAPHY_SOURCE_VERIFIED"]}
  }
}
